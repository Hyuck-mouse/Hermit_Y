PROVIDER=openai
API_KEY=your-api-key-here
BASE_URL=
DEFAULT_MODEL=gpt-4o
TEMPERATURE=0.7
MAX_TOKENS=4096

# Provider options:
# - openai: OpenAI API
# - openrouter: OpenRouter (supports many models)
# - deepseek: DeepSeek API
# - azure: Azure OpenAI
# - anthropic: Anthropic Claude
# - google: Google Gemini
# - local: Local model (e.g., llama.cpp, vLLM)

# OpenRouter example:
# PROVIDER=openrouter
# API_KEY=your-openrouter-key
# DEFAULT_MODEL=gpt-4o

# DeepSeek example:
# PROVIDER=deepseek
# API_KEY=your-deepseek-key
# DEFAULT_MODEL=deepseek-chat

# Local model example:
# PROVIDER=local
# BASE_URL=http://localhost:8080/v1
# DEFAULT_MODEL=your-local-model
